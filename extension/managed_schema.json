{
  "type": "object",
  "properties": {
    "enabled": {
      "title": "Enable the extension",
      "type": "boolean"
    },
    "allowedHosts": {
      "title": "Allowed SharePoint hosts",
      "description": "e.g. [\"contoso.sharepoint.com\", \"contoso-my.sharepoint.com\"]. A bare tenant name (contoso) is also accepted.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "openMode": {
      "title": "Open mode (ofe = edit, ofv = read-only)",
      "type": "string",
      "enum": [
        "ofe",
        "ofv"
      ]
    },
    "autoLaunch": {
      "title": "Launch the app automatically",
      "type": "boolean"
    },
    "closeTabAfterLaunch": {
      "title": "Close the tab after launching",
      "type": "boolean"
    }
  }
}
