{
  "manifest_version": 3,
  "name": "SharePoint Office Launcher",
  "short_name": "SP Office Launcher",
  "version": "1.2.0",
  "description": "許可した SharePoint テナントの PowerPoint / Excel / Word リンクを Office デスクトップアプリで直接開きます。",
  "minimum_chrome_version": "110",
  "permissions": ["webNavigation", "webRequest", "storage"],
  "host_permissions": ["https://*.sharepoint.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
